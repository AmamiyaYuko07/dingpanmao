<Window x:Class="DingPanMao.Views.DetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:DingPanMao.Controls"
        Title="盯盘猫"
        Icon="/Resources/app.ico"
        Width="560"
        Height="620"
        MinWidth="440"
        MinHeight="460"
        Background="#FF1B1D23"
        Foreground="#E9EEF5"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <TextBlock x:Name="NameText"
                       FontSize="15"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock x:Name="PriceText"
                           FontSize="17"
                           FontWeight="SemiBold"
                           FontFamily="Consolas, Microsoft YaHei UI" />
                <TextBlock x:Name="ChangeText"
                           Margin="8,0,0,2"
                           FontSize="12"
                           FontFamily="Consolas, Microsoft YaHei UI"
                           VerticalAlignment="Bottom" />
            </StackPanel>
        </Grid>

        <TextBlock x:Name="StatsText"
                   Grid.Row="1"
                   Margin="0,8,0,0"
                   FontSize="11"
                   FontFamily="Consolas, Microsoft YaHei UI"
                   Foreground="#8A94A6" />

        <Grid Grid.Row="2" Margin="0,14,0,4">
            <TextBlock x:Name="IntradayLabel"
                       FontSize="11"
                       Foreground="#8A94A6"
                       HorizontalAlignment="Left" />
            <TextBlock x:Name="IntradayHover"
                       FontSize="11"
                       FontFamily="Consolas, Microsoft YaHei UI"
                       Foreground="#FFC53D"
                       HorizontalAlignment="Right"
                       TextTrimming="CharacterEllipsis" />
        </Grid>

        <Border Grid.Row="3"
                Background="#FF23262E"
                CornerRadius="4"
                Padding="4">
            <controls:ChartView x:Name="IntradayChart" />
        </Border>

        <Grid Grid.Row="4" Margin="0,14,0,4">
            <TextBlock x:Name="DailyLabel"
                       FontSize="11"
                       Foreground="#8A94A6"
                       HorizontalAlignment="Left" />
            <TextBlock x:Name="DailyHover"
                       FontSize="11"
                       FontFamily="Consolas, Microsoft YaHei UI"
                       Foreground="#FFC53D"
                       HorizontalAlignment="Right"
                       TextTrimming="CharacterEllipsis" />
        </Grid>

        <Border Grid.Row="5"
                Background="#FF23262E"
                CornerRadius="4"
                Padding="4">
            <controls:ChartView x:Name="DailyChart" />
        </Border>
    </Grid>
</Window>
