<Window x:Class="DingPanMao.Views.DetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:DingPanMao.Controls"
        Title="盯盘猫"
        Icon="/Resources/app.ico"
        Width="460"
        Height="420"
        MinWidth="380"
        MinHeight="320"
        Background="#FF1B1D23"
        Foreground="#E9EEF5"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <TextBlock x:Name="NameText" FontSize="14" FontWeight="SemiBold" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock x:Name="PriceText" FontSize="16" FontWeight="SemiBold" FontFamily="Consolas" />
                <TextBlock x:Name="ChangeText" Margin="8,0,0,1" FontSize="12" FontFamily="Consolas"
                           VerticalAlignment="Bottom" />
            </StackPanel>
        </Grid>

        <TextBlock x:Name="IntradayLabel" Grid.Row="1" Margin="0,14,0,4" FontSize="11" Foreground="#8A94A6" />
        <Border Grid.Row="2" Background="#FF23262E" CornerRadius="4" Padding="6">
            <controls:Sparkline x:Name="IntradayChart" />
        </Border>

        <TextBlock x:Name="DailyLabel" Grid.Row="3" Margin="0,14,0,4" FontSize="11" Foreground="#8A94A6" />
        <Border Grid.Row="4" Background="#FF23262E" CornerRadius="4" Padding="6">
            <controls:Sparkline x:Name="DailyChart" />
        </Border>
    </Grid>
</Window>
