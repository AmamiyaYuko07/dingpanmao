<Window x:Class="DingPanMao.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="盯盘猫"
        Icon="/Resources/app.ico"
        Width="560"
        Height="680"
        MinWidth="480"
        MinHeight="520"
        Background="#FF1B1D23"
        Foreground="#E9EEF5"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
            <StackPanel x:Name="Body" />
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="SaveButton" Width="96" Margin="0,0,8,0" Click="OnSaveClick" />
            <Button x:Name="CancelButton" Width="96" Click="OnCancelClick" />
        </StackPanel>
    </Grid>
</Window>
