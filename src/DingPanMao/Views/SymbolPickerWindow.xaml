<Window x:Class="DingPanMao.Views.SymbolPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="盯盘猫"
        Icon="/Resources/app.ico"
        Width="480"
        Height="540"
        MinWidth="420"
        MinHeight="420"
        Background="#FF1B1D23"
        Foreground="#E9EEF5"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBox x:Name="SearchBox"
                 Grid.Row="0"
                 Padding="8,6"
                 FontSize="13"
                 Background="#FF23262E"
                 Foreground="#E9EEF5"
                 BorderBrush="#33FFFFFF" />

        <TextBlock x:Name="StatusText"
                   Grid.Row="1"
                   Margin="2,8,0,0"
                   FontSize="11"
                   Foreground="#8A94A6" />

        <ListBox x:Name="ResultList"
                 Grid.Row="2"
                 Margin="0,8,0,10"
                 Background="#FF23262E"
                 Foreground="#E9EEF5"
                 BorderBrush="#33FFFFFF">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0,3,0,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding Code}"
                                   Margin="10,0,0,0"
                                   FontFamily="Consolas"
                                   Foreground="#7C8797" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="OkButton" Width="92" Margin="0,0,8,0" Click="OnOkClick" />
            <Button x:Name="CancelButton" Width="92" Click="OnCancelClick" />
        </StackPanel>
    </Grid>
</Window>
